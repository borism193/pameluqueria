---
import { siteData } from '../data/siteData';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteData.brand.name} | ${siteData.brand.tagline}`,
  description = 'Estudio de estilismo, coloración de autor, cortes personalizados y rituales capilares por Pamela. Reservá tu turno por WhatsApp.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={siteData.hero.image} />

    <!-- Google Fonts: Cormorant Garamond (Serif elegante) & Plus Jakarta Sans (Sans moderna) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-cream text-charcoal font-sans antialiased selection:bg-blush selection:text-charcoal overflow-x-hidden">
    <slot />
  </body>
</html>
