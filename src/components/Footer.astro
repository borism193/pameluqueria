---
import { siteData, getWhatsAppLink } from '../data/siteData';
---

<footer class="bg-charcoal text-cream py-14 border-t border-gold/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 pb-10 border-b border-cream/10">
      <div class="text-center md:text-left">
        <span class="font-serif text-3xl font-semibold tracking-tight text-cream">
          {siteData.brand.name}
        </span>
        <p class="text-xs uppercase tracking-[0.22em] text-gold-light mt-1">
          {siteData.brand.tagline}
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-6 text-xs uppercase tracking-widest text-cream/80">
        <a href="#inicio" class="hover:text-gold-light transition-colors">Inicio</a>
        <a href="#servicios" class="hover:text-gold-light transition-colors">Servicios</a>
        <a href="#sobre-pamela" class="hover:text-gold-light transition-colors">Sobre Pamela</a>
        <a href="#galeria" class="hover:text-gold-light transition-colors">Galería</a>
        <a href="#contacto" class="hover:text-gold-light transition-colors">Turnos</a>
      </div>

      <a
        href={getWhatsAppLink()}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-gold hover:bg-gold-dark text-charcoal hover:text-cream text-xs uppercase tracking-widest font-semibold px-6 py-3 rounded-full transition-colors"
      >
        <span>WhatsApp Directo</span>
      </a>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-cream/60">
      <p>© {new Date().getFullYear()} {siteData.brand.name}. Todos los derechos reservados.</p>
      <p>Hecho con dedicación para resaltar tu belleza natural ✨</p>
    </div>
  </div>
</footer>
